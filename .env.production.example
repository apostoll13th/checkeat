# CheckEat Production Environment Configuration

###############################################################################
# ОСНОВНЫЕ НАСТРОЙКИ
###############################################################################

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# База данных PostgreSQL
DB_NAME=checkeat
DB_USER=checkeat_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# JWT & Security
SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY_64_CHARS_HERE
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_64_CHARS_HERE
ACCESS_TOKEN_EXPIRE_MINUTES=30

###############################################################################
# CORS & NETWORKING
###############################################################################

CORS_ORIGINS=https://yourapp.com,https://www.yourapp.com
API_PORT=8000

###############################################################################
# DOCKER SETTINGS
###############################################################################

DOCKERHUB_USERNAME=your_dockerhub_username

###############################################################################
# BACKUP SETTINGS
###############################################################################

BACKUP_DIR=/var/backups/checkeat
RETENTION_DAYS=30

# AWS S3 (опционально для облачных бекапов)
# AWS_S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

###############################################################################
# МОНИТОРИНГ (опционально)
###############################################################################

# Sentry для отслеживания ошибок
# SENTRY_DSN=https://your_sentry_dsn

# Prometheus metrics
# ENABLE_METRICS=true

###############################################################################
# EMAIL NOTIFICATIONS (опционально)
###############################################################################

# SMTP для уведомлений
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# EMAIL_FROM=noreply@checkeat.com
