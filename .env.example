# CheckEat Environment Variables
# Скопируйте этот файл в .env и заполните своими значениями

# ===========================
# OPENAI API
# ===========================
# Получите ключ на https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini

# ===========================
# BACKEND SECURITY
# ===========================
# Сгенерируйте случайные ключи, например: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key_change_this_to_random_string
SECRET_KEY=your_secret_key_change_this_to_random_string

# ===========================
# DATABASE (для production)
# ===========================
# Для docker-compose.yml эти значения уже настроены
# Измените только для production деплоя
POSTGRES_DB=checkeat_db
POSTGRES_USER=checkeat_user
POSTGRES_PASSWORD=checkeat_password
DATABASE_URL=postgresql://checkeat_user:checkeat_password@postgres:5432/checkeat_db

# ===========================
# REDIS
# ===========================
REDIS_URL=redis://redis:6379/0

# ===========================
# APPLICATION
# ===========================
DEBUG=True
